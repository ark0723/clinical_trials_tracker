# Leave empty for local `npm run dev` (Vite proxies /api → http://127.0.0.1:8000).
# On Vercel, set this to the public API origin (no trailing slash), e.g.:
#   VITE_API_BASE_URL=https://your-api.example.com
# or a temporary ngrok tunnel to local FastAPI:
#   VITE_API_BASE_URL=https://xxxx.ngrok-free.dev
VITE_API_BASE_URL=
