# Copy to .env for local development: cp .env.example .env
# Local dev default matches docker-compose.yml's postgres service.
# For production (Neon), paste your connection string here (scheme must be
# postgresql+psycopg://) -- never commit real credentials to this file.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clinical_tracker

CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
CTGOV_CONDITION_QUERY=HER2-positive breast cancer
CTGOV_PAGE_SIZE=100

# Fernet key for encrypting user health data at rest.
# Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROFILE_ENCRYPTION_KEY=
