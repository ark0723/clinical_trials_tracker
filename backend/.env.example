# Copy to .env for local development: cp .env.example .env
# Local dev default matches docker-compose.yml's postgres service.
# For production (Neon), paste your connection string here (scheme must be
# postgresql+psycopg://) -- never commit real credentials to this file.
# Tip: prefer Neon's pooled endpoint (-pooler in the hostname) for app traffic.
# Keep the direct (non-pooler) URL for Alembic migrations if needed.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clinical_tracker

CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
CTGOV_CONDITION_QUERY=HER2-positive breast cancer
CTGOV_PAGE_SIZE=100

# Fernet key for encrypting user health data at rest.
# Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROFILE_ENCRYPTION_KEY=

# Web Push VAPID keys (Browser notifications — default channel).
# Generate with:
#   uv run python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.private_pem().decode()); print(v.public_key.public_bytes(...))"
# Or see backend README. Leave empty in tests; BrowserPushProvider is skipped when unset.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:alerts@clinicaltrialnavigator.local

# Comma-separated origins for browser clients that call the API directly
# (e.g. Vercel frontend). Leave empty when using the Vite /api proxy only.
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=
